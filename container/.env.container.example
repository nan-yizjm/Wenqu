# 复制为一个不会提交的文件，例如 container/.env.container.local；不要写 API Key。
# Windows Docker Desktop 接受正斜杠路径。包含空格时不要额外加引号。
RAG_VAULT_DIR=C:/replace/with/your/Obsidian Vault/10_技术学习/概念笔记/大模型
RAG_OLLAMA_BASE_URL=http://host.docker.internal:11434
RAG_OLLAMA_MODEL=qwen2.5:7b
RAG_PORT=8000
# 默认可不写；如要复用已有 Hugging Face 缓存，可改成宿主机绝对路径。
RAG_HF_CACHE_DIR=./data/generated/container_hf_cache
